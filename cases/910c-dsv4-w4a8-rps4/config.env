# Settings for the 2026-11-23 reference. Node-specific paths are in site.env.
export SERVED_MODEL_NAME=dsv4
export PREFILL_TOPOLOGY=legacy PREFILL_NODE_ID=0 PREFILL_ENABLE_KV_CONNECTOR=1
export MAX_MODEL_LEN=65536 BLOCK_SIZE=128 DSV4_INDEXER_KV_DTYPE=int8
export DECODE_DP_SIZE=16 DECODE_TP_SIZE=1
export DECODE_MAX_NUM_SEQS=2 DECODE_MAX_NUM_BATCHED_TOKENS=120
export DECODE_GPU_MEMORY_UTILIZATION=0.9
export DECODE_SPECULATIVE_CONFIG='{"method":"dspark","num_speculative_tokens":5,"enforce_eager":true}'
export BASELINE_VLLM_PLUGINS=ascend,ascend_kv_connector,ascend_model,ascend_model_loader,ascend_service_profiling
export AFD_VLLM_PLUGINS=ascend,ascend_model,ascend_model_loader,ascend_service_profiling,afd
export AFD_FORCE_BALANCED_TOPK_IDS=0 AFD_CAM_OP_IO_LOG=0 AFD_ASYNC_MOE_LAYOUT_LOG=0
export PREFILL_FLASHCOMM1=1 ENABLE_SHARED_EXPERT_DP=true ENABLE_CPU_BINDING=true
export PREFILL_PORT=7100 FFN_PORT=7101 DECODE_PORT=7100
export PREFILL_DP_RPC_PORT=12321 DECODE_DP_RPC_PORT=12321
export AFD_PORT=1239 PD_KV_PREFILL_PORT=30000 PD_KV_DECODE_PORT=30100

# Baseline P and AFD P values are selected by role in scripts/launch.sh.
BASELINE_MBT=8192
BASELINE_MAX_SEQS=8
BASELINE_UTILIZATION=0.9
AFD_MBT=32768
AFD_MAX_SEQS=16
AFD_UTILIZATION=0.7
export PREFILL_ENABLE_DBO=1
export PREFILL_DBO_PREFILL_TOKEN_THRESHOLD=512 PREFILL_DBO_DECODE_TOKEN_THRESHOLD=32
export PREFILL_FFN_GRAPH_MODE=EAGER FFN_MAX_NUM_SEQS=16
export AFD_ASYNC_CAM_LAYERED_GMM=1 BATCH_SIZE_FACTOR=0.25
